{
  "name": "memhaul",
  "version": "0.1.0",
  "description": "Local-first CLI that turns a ChatGPT or Claude data export into clean, human-readable memory files you own.",
  "type": "module",
  "license": "MIT",
  "author": "Briggs Ventures LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tempreon/memhaul.git"
  },
  "bugs": {
    "url": "https://github.com/Tempreon/memhaul/issues"
  },
  "homepage": "https://github.com/Tempreon/memhaul#readme",
  "bin": {
    "memhaul": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "verify:claude": "node --import tsx scripts/verify-claude-export.ts",
    "start": "node --import tsx src/cli.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "chatgpt",
    "claude",
    "memory",
    "export",
    "data-portability",
    "local-first",
    "cli",
    "ai-memory",
    "privacy"
  ],
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  }
}
